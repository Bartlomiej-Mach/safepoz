---
import { cities } from '../../data/cities.ts';

interface Props {
  showCities?: boolean;
}

const { showCities = false } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    {showCities && (
      <section class="site-footer__areas" aria-labelledby="footer-areas-title">
        <div class="site-footer__areas-heading">
          <p class="eyebrow">Działamy w całej Polsce</p>
          <h2 id="footer-areas-title">Usługi PPOŻ w Twoim mieście</h2>
        </div>
        <ul class="site-footer__city-list">
          {cities.map((city) => (
            <li><a href={`/uslugi-ppoz/${city.slug}`}>{city.name}</a></li>
          ))}
        </ul>
      </section>
    )}
    <section class="site-footer__company" aria-labelledby="footer-company-title">
      <div class="site-footer__experience">
        <p class="eyebrow">25 lat na rynku</p>
        <h2 id="footer-company-title">Doświadczenie, które wspiera bezpieczeństwo Twojego obiektu.</h2>
      </div>
      <div class="site-footer__contact">
        <h3>Dane kontaktowe firmy SAFEPOŻ</h3>
        <dl class="site-footer__details">
          <div>
            <dt>Adres</dt>
            <dd><address>Katowice, ul. Daszyńskiego 40/34, 40-834</address></dd>
          </div>
          <div>
            <dt>NIP</dt>
            <dd>6491861825</dd>
          </div>
          <div>
            <dt>REGON</dt>
            <dd>277599717</dd>
          </div>
          <div>
            <dt>Telefon</dt>
            <dd><a href="tel:+48538111324">538 111 324</a></dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd><a href="mailto:safepozbiuro@gmail.com">safepozbiuro@gmail.com</a></dd>
          </div>
        </dl>
      </div>
    </section>
    <div class="site-footer__bottom">
      <a class="site-logo site-logo--footer" href="/" aria-label="SAFEPOŻ, strona główna">
        <span class="site-logo__mark" aria-hidden="true">S</span>
        <span class="site-logo__word">SAFEPOŻ<span class="site-logo__period">.</span></span>
      </a>
      <nav class="site-footer__nav" aria-label="Nawigacja w stopce">
        <a href="/">Strona główna</a>
        <a href="/#uslugi">Usługi</a>
        <a href="/kontakt">Kontakt</a>
      </nav>
      <p class="site-footer__copyright">© {new Date().getFullYear()} SAFEPOŻ. Wszelkie prawa zastrzeżone.</p>
    </div>
  </div>
</footer>